---
import '../styles/global.css';

import chileRts from '../assets/chile-rts.png';
import voleiManager from '../assets/volei-manager.png';
import cuatroVolei from '../assets/4volei-portada.webp';
import palestra from '../assets/palestra-ronda.webp';
import efis from '../assets/efisSS.png';
import retrato from '../assets/FotoPerfil1.png';

const experiments = [
  { number: '01', title: 'Construir sin servidor', text: 'Un site-builder que vive en tu navegador y viaja contigo dentro de un archivo JSON.', status: 'Demo disponible' },
  { number: '02', title: 'Simular un partido', text: 'Probabilidad, táctica y cientos de partidos invisibles para entender uno solo.', status: 'En desarrollo' },
  { number: '03', title: 'Construir un mundo', text: 'Mapas, economías y unidades que obedecen las mismas reglas en cada computador.', status: 'Código abierto pronto' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="description" content="El taller digital de Joel Herrera: juegos, herramientas para el deporte y experimentos con historia, simulación y comunidad." />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <title>Joel Herrera — Taller digital</title>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="#inicio" aria-label="Ir al inicio"><span>JH</span><small>Taller digital</small></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span class="sr-only">Abrir menú</span>
      </button>
      <nav id="main-nav" aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a>
        <a href="/constructor/">Constructor</a>
        <a href="#sobre-mi">Sobre mí</a>
        <a class="nav-contact" href="mailto:joelherreraleiva@gmail.com">Escríbeme ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero-kicker reveal"><span class="live-dot"></span>Desde Coquimbo, Chile</div>
        <div class="hero-title reveal" style="--delay: .08s">
          <h1>Construyo <em>juegos</em>,<br />herramientas y<br />pequeños <span>mundos.</span></h1>
        </div>
        <div class="hero-bottom reveal" style="--delay: .16s">
          <p>Este no es un catálogo de servicios. Es el lugar donde reúno software para el deporte, simulaciones, historias chilenas y todo lo que todavía estoy aprendiendo.</p>
          <a class="round-link" href="#proyectos" aria-label="Ver proyectos"><span>Ver<br />proyectos</span><b>↓</b></a>
        </div>
        <div class="hero-stamp" aria-hidden="true">
          <svg viewBox="0 0 140 140"><defs><path id="circle" d="M70,70 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0" /></defs><text><textPath href="#circle">JUEGOS · DEPORTE · CÓDIGO · CURIOSIDAD · </textPath></text></svg>
          <span>✦</span>
        </div>
      </section>

      <div class="marquee" aria-label="Temas del sitio">
        <div class="marquee-track"><span>SIMULACIÓN</span><i>✦</i><span>VÓLEIBOL</span><i>✦</i><span>HISTORIA</span><i>✦</i><span>JUEGOS</span><i>✦</i><span>SIMULACIÓN</span><i>✦</i><span>VÓLEIBOL</span><i>✦</i><span>HISTORIA</span><i>✦</i><span>JUEGOS</span><i>✦</i></div>
      </div>

      <section class="projects-intro" id="proyectos">
        <div class="section-label reveal"><span>01</span> Proyectos principales</div>
        <div class="intro-grid">
          <h2 class="reveal">Cosas que tienen<br />vida propia.</h2>
          <p class="reveal" style="--delay: .1s">Primero está lo que ya vive fuera de mi computador; después, los juegos y experimentos que todavía están creciendo.</p>
        </div>
      </section>

      <article class="project-feature project-dark" aria-labelledby="cuatro-volei-title">
        <div class="project-copy reveal">
          <div class="project-meta"><span>Empresa de tecnología deportiva</span><span>En producción</span></div>
          <h3 id="cuatro-volei-title">4Volei</h3>
          <p>La plataforma que convertí en empresa. Organiza torneos, equipos, estadísticas y transmisiones para el vóleibol amateur chileno; hoy tiene usuarios reales y una suscripción mensual activa.</p>
          <div class="project-notes"><span>Empresa formalizada</span><span>Clientes reales</span><span>Producto vivo</span></div>
          <div class="project-links"><a class="text-link light" href="https://4volei.cl/" target="_blank" rel="noreferrer">Visitar 4Volei <b>↗</b></a><a class="text-link light" href="/constructor/">Probar el site-builder <b>↗</b></a></div>
        </div>
        <a class="project-image reveal" style="--delay: .12s" href="https://4volei.cl/" target="_blank" rel="noreferrer" aria-label="Visitar 4Volei">
          <img src={cuatroVolei.src} alt="Presentación de la plataforma 4Volei" loading="lazy" /><span class="image-index">001</span>
        </a>
      </article>

      <article class="project-feature project-light reverse" aria-labelledby="volei-manager-title">
        <div class="project-copy reveal">
          <div class="project-meta"><span>Manager multijugador</span><span>Demo web</span></div>
          <h3 id="volei-manager-title">Volei<br /><em>Manager</em></h3>
          <p>Empiezas con una cancha de tierra y terminas levantando un polideportivo. Un juego de gestión donde las decisiones deportivas también enseñan probabilidad y estadística.</p>
          <div class="project-notes"><span>Mundo persistente</span><span>Monte Carlo</span><span>Economía</span></div>
          <div class="project-links"><a class="text-link" href="https://volei-game-navy.vercel.app/" target="_blank" rel="noreferrer">Jugar la demo <b>↗</b></a><a class="text-link" href="https://github.com/Joelherr09/volei-game" target="_blank" rel="noreferrer">Ver el código <b>↗</b></a></div>
        </div>
        <a class="project-image reveal" style="--delay: .12s" href="https://volei-game-navy.vercel.app/" target="_blank" rel="noreferrer" aria-label="Jugar Volei Manager">
          <img src={voleiManager.src} alt="Vista isométrica de un club en Volei Manager" loading="lazy" /><span class="image-index">002</span>
        </a>
      </article>

      <article class="project-feature project-red" aria-labelledby="chile-rts-title">
        <div class="project-copy reveal">
          <div class="project-meta"><span>Juego de estrategia</span><span>Próximo: versión web</span></div>
          <h3 id="chile-rts-title">Chile<br /><em>RTS</em></h3>
          <p>Un juego de estrategia en tiempo real inspirado en la historia de Chile. Motor isométrico propio, simulación determinista y nueve pueblos que comparten un mismo mapa. Su versión web vendrá después.</p>
          <div class="project-notes"><span>C11 + raylib</span><span>Motor propio</span><span>Arte 3D</span></div>
          <a class="text-link light" href="https://github.com/Joelherr09/chile-rts" target="_blank" rel="noreferrer">Explorar el proyecto <b>↗</b></a>
        </div>
        <a class="project-image reveal" style="--delay: .12s" href="https://github.com/Joelherr09/chile-rts" target="_blank" rel="noreferrer" aria-label="Ver Chile RTS en GitHub">
          <img src={chileRts.src} alt="Partida de Chile RTS con una ciudad en vista isométrica" loading="lazy" /><span class="image-index">003</span>
        </a>
      </article>

      <section class="community">
        <div class="section-label reveal"><span>02</span> Deporte & comunidad</div>
        <div class="community-head reveal"><h2>Software que sale<br />de la pantalla.</h2><p>Proyectos hechos junto a clubes, ligas y personas reales.</p></div>
        <div class="community-grid">
          <article class="community-card reveal">
            <a class="card-image" href="https://ligapalestra.app/" target="_blank" rel="noreferrer"><img src={palestra.src} alt="Jugadores de vóleibol reunidos en una cancha" loading="lazy" /></a>
            <div class="card-copy"><span>Identidad + plataforma</span><h3>Liga Palestra</h3><p>Una experiencia editorial para presentar partidos, posiciones y clubes con una identidad propia.</p><a class="text-link" href="https://ligapalestra.app/" target="_blank" rel="noreferrer">Visitar sitio <b>↗</b></a></div>
          </article>
          <article class="community-card reveal" style="--delay: .1s">
            <div class="card-image"><img src={efis.src} alt="Sitio web del club Atlético EFIS" loading="lazy" /></div>
            <div class="card-copy"><span>Club + comunidad</span><h3>Atlético EFIS</h3><p>Noticias, profesores, calendario y la memoria cotidiana de un club construido alrededor de su gente.</p><a class="text-link" href="https://www.efisvoley.cl/" target="_blank" rel="noreferrer">Visitar sitio <b>↗</b></a></div>
          </article>
        </div>
      </section>

      <section class="lab" id="laboratorio">
        <div class="section-label section-label-light reveal"><span>03</span> Laboratorio</div>
        <div class="lab-head reveal"><h2>Ideas abiertas,<br /><em>todavía inquietas.</em></h2><div class="lab-intro"><p>Procesos, herramientas y piezas que quiero convertir en recursos abiertos.</p><a class="lab-button" href="/constructor/">Probar el constructor local ↗</a></div></div>
        <div class="experiment-list">
          {experiments.map((experiment) => (
            <article class="experiment reveal"><span class="experiment-number">{experiment.number}</span><h3>{experiment.title}</h3><p>{experiment.text}</p><span class="experiment-status">{experiment.status}</span><span class="experiment-arrow" aria-hidden="true">↗</span></article>
          ))}
        </div>
      </section>

      <section class="about" id="sobre-mi">
        <div class="about-portrait reveal"><div class="portrait-frame"><img src={retrato.src} alt="Retrato de Joel Herrera" loading="lazy" /></div><span>Coquimbo · Chile</span></div>
        <div class="about-copy reveal" style="--delay: .1s">
          <div class="section-label"><span>04</span> Sobre mí</div>
          <h2>Hola, soy Joel.</h2>
          <p class="about-lead">Me gusta convertir intereses muy específicos en software que se pueda usar, jugar o compartir.</p>
          <p>Últimamente trabajo entre canchas de vóleibol, mapas isométricos, sistemas de simulación y herramientas para comunidades deportivas. Este sitio es una bitácora de ese recorrido, no una obra terminada.</p>
          <div class="about-links"><a href="mailto:joelherreraleiva@gmail.com">Correo ↗</a><a href="https://github.com/Joelherr09" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://twitter.com/joelherr09" target="_blank" rel="noreferrer">X / Twitter ↗</a></div>
        </div>
      </section>

      <section class="closing"><p class="reveal">¿Tienes una idea extraña,<br />de esas que vale la pena intentar?</p><a class="closing-link reveal" style="--delay: .1s" href="mailto:joelherreraleiva@gmail.com">Hablemos <span>↗</span></a></section>
    </main>

    <footer>
      <a class="wordmark footer-mark" href="#inicio"><span>JH</span><small>Taller digital</small></a>
      <p>Juegos, deporte, código y curiosidad.<br />Hecho desde Coquimbo.</p>
      <div><span>© 2026</span><a href="#inicio">Volver arriba ↑</a></div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal');
      if (reducedMotion) revealItems.forEach((item) => item.classList.add('is-visible'));
      else {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: 0.14, rootMargin: '0px 0px -6% 0px' });
        revealItems.forEach((item) => observer.observe(item));
      }
      const progress = document.querySelector('.scroll-progress');
      const updateProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const value = max > 0 ? window.scrollY / max : 0;
        if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${value})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
    </script>
  </body>
</html>
